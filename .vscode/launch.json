{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // k8shell-db-postgresql-dev
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go identity",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go", // Path to your Go file or main package
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "--logtext",
                "--config",
                "config/config.yaml",
            ],
            "showLog": true,
            //"stopOnEntry": true
        },
        {
            "name": "Attach to running identity",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 3502,
            "showLog": true,
            "asRoot": true,
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/go/src/identity"
                }
            ]
        },
        {
            "name": "Connect to Delve server",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/home/bruckins/identity",
            "port": 2345,
            "host": "127.0.0.1",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/go/src/identity"
                }
            ]
        }
    ]
}