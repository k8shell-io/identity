### authenticate user
POST http://localhost:9090/api/v1/users/vitvatom/authenticate
Authorization: Bearer 6f16982b35ac2168f86c7978b7b42967538939b063598346139e0963510c
Content-Type: application/json

{
    "public_key":"ssh-rsa  Tomáš Vitvar (gitlab.fit.cvut.cz)"
}

### create a session for user
POST http://localhost:9090/api/v1/users/vitvatom/sessions
Authorization: Bearer 6f16982b35ac2168f86c7978b7b42967538939b063598346139e0963510c

{
  "client_ip": "192.168.1.10",
  "proxy_id": "abcdefg",
  "proxy_pid": 12345,
  "workspace": "test"
}

### get all sessions for user
GET http://localhost:9090/api/v1/users/vitvatom/sessions
Authorization: Bearer 6f16982b35ac2168f86c7978b7b42967538939b063598346139e0963510c
Content-Type: application/json

### get last session for user
GET http://localhost:9090/api/v1/users/vitvatom/sessions?reverse=true&limit=1
Authorization: Bearer 6f16982b35ac2168f86c7978b7b42967538939b063598346139e0963510c
Content-Type: application/json