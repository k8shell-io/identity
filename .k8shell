blueprint:
  name: identity
  template: default
  image: ${WORKSPACE_REGISTRY}/workspaces/dev:0.8-1.2
  sudo: true
  network_policy: workspace
  resources:
    limits:
      cpu: 8
      memory: 8Gi

  dind:
    enabled: true
    docker_dns:
      enabled: true
      resolver:
        cluster_fqdn: true

  init_scripts:
    files:
      - clone_repo@: |
          #!/bin/sh
          mkdir -p $HOME/workspace
          cd $HOME/workspace
          git clone git@github.com:k8shell-io/identity.git

