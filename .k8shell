blueprint:
  name: identity
  template: development
  image: ${WORKSPACE_REGISTRY}/workspaces/dev:0.8-1.6
  sudo: true
  network_policy: workspace
  resources:
    limits:
      cpu: 8
      memory: 8Gi

  init_scripts:
    files:
      - init_repo@&: |
          go env -w GOPRIVATE=github.com/k8shell-io/*
          cd $HOME/workspace/identity
          swag init --generalInfo internal/server/restapi.go --output docs          
          export GOPATH="$HOME/go"
          echo "export GOPATH=$GOPATH" 
          pwd
          go mod tidy

      - run_compose@&: |
          #!/bin/sh
          sleep 10
          cd $HOME/workspace/identity/backend
          pwd
          docker compose up -d


