blueprint:
  name: identity
  template: default
  image: ${WORKSPACE_REGISTRY}/workspaces/dev:0.8-1.2
  sudo: true
  network_policy: workspace
  resources:
    limits:
      cpu: 8
      memory: 8Gi

  dind:
    enabled: true
    docker_dns:
      enabled: true
      resolver:
        cluster_fqdn: true

  init_scripts:
    files:
      - clone_repo@: |
          #!/bin/sh
          cd $HOME/workspace
          git clone https://u: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@github.com/k8shell-io/identity.git
          go env -w GOPRIVATE=github.com/k8shell-io/*
          git config --global url."https://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@github.com/".insteadOf "https://github.com/"
          cd $HOME/workspace/identity
          go mod tidy 

