blueprint:
  name: identity
  template: development

  shell: /bin/zsh
  image: ${WORKSPACE_REGISTRY}/workspaces/dev:0.8-1.8
  sudo: true
  network_policy: workspace
  resources:
    limits:
      cpu: 8
      memory: 16Gi

  init_scripts:
    files:
      - init_repo@&: |
          go env -w GOPRIVATE=github.com/k8shell-io/*
          cd $HOME/workspace/identity
          swag init --generalInfo internal/server/restapi.go --output docs    
          echo "*** GOPATH=$GOPATH"      
          GOPATH="$HOME/go" go mod tidy

      - run_compose@&: |
          rm -fr $HOME/.docker
          cd $HOME/workspace/identity/backend
          docker compose up -d


